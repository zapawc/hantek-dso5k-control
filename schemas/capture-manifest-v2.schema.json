  "title": "Hantek read-only qualification manifest v2",
  "type": "object",
  "required": [
    "schema_version",
    "software_version",
    "source_commit",
    "run_id",
    "start_utc",
    "end_utc",
    "device",
    "host",
    "exit_code",
